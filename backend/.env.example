# InvoShield AI - Backend Environment Configuration
APP_NAME=InvoShield AI
APP_ENV=development
PORT=8000
DEBUG=True

DATABASE_URL=postgresql://invoshield_user:invoshield_password@postgres:5432/invoshield_db
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AES_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=invoshield-invoices
S3_REGION=us-east-1
S3_USE_SSL=False

LOCAL_STORAGE_DIR=./storage_data
TESSERACT_CMD=
OCR_LANGUAGE=eng
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Demo accounts (admin/reviewer/user@invoshield.ai) are created only outside production.
SEED_DEMO_USERS=True
# Production: first admin, forced to change this password on first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ORGANIZATION=General
# Extractor fills unreadable fields with sample values (UI demos only). Set False for real use.
EXTRACTION_DEMO_FALLBACKS=True

# ---------------- InvoShield Assistant (WhatsApp / email agent) ----------------
AGENT_ENABLED=True
# Which AI: gemini (Google) or anthropic (Claude). Easiest: run  python -m scripts.configure
AGENT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-latest
AGENT_MAX_TOKENS=1024
# mock = record messages only (safe for demos); live = really send via Meta / SMTP
AGENT_CHANNEL_MODE=mock
# Organization that unknown senders and the WhatsApp number belong to (must match your users' organization)
AGENT_DEFAULT_ORGANIZATION=General
AGENT_BUSINESS_NAME=Our Business
AGENT_TIMEZONE=Asia/Kolkata
AGENT_RATE_LIMIT_PER_MINUTE=20
AGENT_MAX_MEDIA_MB=10
AGENT_CONFIRMATION_TTL_MINUTES=15

# WhatsApp Business Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# Email channel (webhook secret for inbound JSON; IMAP for polling; SMTP for replies)
EMAIL_WEBHOOK_SECRET=
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
